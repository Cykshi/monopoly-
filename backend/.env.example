# Backend Environment Variables Example

# Server listening port (default: 3001)
PORT=3001

# Application environment ('development' | 'production' | 'test')
NODE_ENV=development

# Allowed frontend origins for CORS (comma-separated for multiple origins)
CLIENT_URL=http://localhost:3000

# Directory path where persisted room JSON files are saved (default: ./data)
DATA_DIR=./data

# Time limit in milliseconds per player turn before server auto-timeout (default: 120000 -> 2 minutes)
TURN_TIME_LIMIT_MS=120000

# Grace period in milliseconds for rooms restored from disk at boot before reaping if empty (default: 900000 -> 15 minutes)
RESTORED_ROOM_TTL_MS=900000
